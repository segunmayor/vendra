// One Postgres schema per module group. Foreign keys never cross a schema:
// cross-context references are plain UUID columns. See docs/architecture/data-ownership.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
  schemas   = ["platform", "identity", "customers", "sellers", "catalogue", "inventory", "cart", "orders", "payments", "ledger", "shipping", "storage"]
}

// ---------- platform ----------

model OutboxEvent {
  id          String    @id @default(uuid()) @db.Uuid
  type        String
  aggregateId String    @db.Uuid
  payload     Json
  occurredAt  DateTime  @db.Timestamptz
  publishedAt DateTime? @db.Timestamptz
  attempts    Int       @default(0)
  lastError   String?

  @@index([publishedAt, occurredAt])
  @@map("outbox_events")
  @@schema("platform")
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @default(now()) @db.Timestamptz
  updatedBy String?  @db.Uuid

  @@map("settings")
  @@schema("platform")
}

model IdempotencyRecord {
  id           String   @id @default(uuid()) @db.Uuid
  scope        String
  key          String
  requestHash  String
  responseCode Int?
  responseBody Json?
  createdAt    DateTime @default(now()) @db.Timestamptz

  @@unique([scope, key])
  @@map("idempotency_records")
  @@schema("platform")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  action     String
  targetType String
  targetId   String
  before     Json?
  after      Json?
  ipAddress  String?
  createdAt  DateTime @default(now()) @db.Timestamptz

  @@index([targetType, targetId])
  @@index([actorId, createdAt])
  @@map("audit_logs")
  @@schema("platform")
}

// ---------- identity ----------

enum AccountAudience {
  store
  admin
  vendor

  @@schema("identity")
}

model Account {
  id            String            @id @default(uuid()) @db.Uuid
  audience      AccountAudience
  email         String
  phone         String?
  passwordHash  String
  status        String            @default("active")
  mfaSecret     String?
  mfaEnabledAt  DateTime?         @db.Timestamptz
  mfaLastStep   BigInt?
  createdAt     DateTime          @default(now()) @db.Timestamptz
  updatedAt     DateTime          @updatedAt @db.Timestamptz
  sessions      Session[]
  roles         AccountRole[]
  recoveryCodes MfaRecoveryCode[]
  mfaChallenges MfaChallenge[]

  @@unique([audience, email])
  @@map("accounts")
  @@schema("identity")
}

model LoginFailure {
  id         String   @id @default(uuid()) @db.Uuid
  key        String
  occurredAt DateTime @db.Timestamptz

  @@index([key, occurredAt])
  @@map("login_failures")
  @@schema("identity")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  accountId        String    @db.Uuid
  familyId         String    @db.Uuid
  refreshTokenHash String    @unique
  expiresAt        DateTime  @db.Timestamptz
  revokedAt        DateTime? @db.Timestamptz
  mfa              Boolean   @default(false)
  createdAt        DateTime  @default(now()) @db.Timestamptz
  account          Account   @relation(fields: [accountId], references: [id])

  @@index([familyId])
  @@map("sessions")
  @@schema("identity")
}

model MfaRecoveryCode {
  id        String    @id @db.Uuid
  accountId String    @db.Uuid
  codeHash  String
  usedAt    DateTime? @db.Timestamptz
  createdAt DateTime  @default(now()) @db.Timestamptz
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, codeHash])
  @@map("mfa_recovery_codes")
  @@schema("identity")
}

model MfaChallenge {
  id        String    @id @db.Uuid
  accountId String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz
  attempts  Int       @default(0)
  usedAt    DateTime? @db.Timestamptz
  createdAt DateTime  @default(now()) @db.Timestamptz
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@map("mfa_challenges")
  @@schema("identity")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique
  permissions RolePermission[]
  accounts    AccountRole[]

  @@map("roles")
  @@schema("identity")
}

model RolePermission {
  roleId     String @db.Uuid
  permission String
  role       Role   @relation(fields: [roleId], references: [id])

  @@id([roleId, permission])
  @@map("role_permissions")
  @@schema("identity")
}

model AccountRole {
  accountId String  @db.Uuid
  roleId    String  @db.Uuid
  account   Account @relation(fields: [accountId], references: [id])
  role      Role    @relation(fields: [roleId], references: [id])

  @@id([accountId, roleId])
  @@map("account_roles")
  @@schema("identity")
}

// ---------- customers ----------

model CustomerProfile {
  id        String    @id @default(uuid()) @db.Uuid
  accountId String    @unique @db.Uuid
  firstName String
  lastName  String
  createdAt DateTime  @default(now()) @db.Timestamptz
  addresses Address[]

  @@map("customer_profiles")
  @@schema("customers")
}

model Address {
  id         String          @id @default(uuid()) @db.Uuid
  customerId String          @db.Uuid
  recipient  String
  phone      String
  line1      String
  line2      String?
  city       String
  state      String
  country    String          @default("NG")
  isDefault  Boolean         @default(false)
  customer   CustomerProfile @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@map("addresses")
  @@schema("customers")
}

// ---------- sellers ----------

enum SellerType {
  first_party
  marketplace
  supplier

  @@schema("sellers")
}

model Seller {
  id                 String             @id @default(uuid()) @db.Uuid
  type               SellerType
  displayName        String
  legalName          String
  status             String             @default("pending_verification")
  ownerAccount       String?            @db.Uuid
  businessKind       String?
  registrationNumber String?
  taxId              String?
  phone              String?
  address            Json?
  description        String?
  version            Int                @default(0)
  createdAt          DateTime           @default(now()) @db.Timestamptz
  updatedAt          DateTime           @default(now()) @updatedAt @db.Timestamptz
  cases              VerificationCase[]
  documents          SellerDocument[]

  @@index([type, status])
  @@index([registrationNumber], map: "sellers_registration_number_idx")
  @@map("sellers")
  @@schema("sellers")
}

model VerificationCase {
  id         String    @id @default(uuid()) @db.Uuid
  sellerId   String    @db.Uuid
  status     String    @default("submitted")
  /// What was submitted: { profile, documentIds }.
  documents  Json
  reviewedBy String?   @db.Uuid
  reviewedAt DateTime? @db.Timestamptz
  notes      String?
  createdAt  DateTime  @default(now()) @db.Timestamptz
  seller     Seller    @relation(fields: [sellerId], references: [id])

  @@index([sellerId])
  @@index([sellerId, createdAt], map: "verification_cases_seller_created_idx")
  @@map("verification_cases")
  @@schema("sellers")
}

/// Verification documents. Kept in the database at launch (low volume, no file store chosen yet).
model SellerDocument {
  id              String    @id @db.Uuid
  sellerId        String    @db.Uuid
  kind            String
  fileName        String
  contentType     String
  sizeBytes       Int
  sha256          String
  /// The file itself while files are kept in the database; null when it is in a storage location.
  content         Bytes?
  /// storage.objects.id when the file is kept in a storage location. Not a foreign key: another schema.
  storageObjectId String?   @db.Uuid
  uploadedAt      DateTime  @db.Timestamptz
  removedAt       DateTime? @db.Timestamptz
  seller          Seller    @relation(fields: [sellerId], references: [id])

  @@index([sellerId])
  @@map("seller_documents")
  @@schema("sellers")
}

// ---------- catalogue (including listings) ----------

model Category {
  id              String     @id @default(uuid()) @db.Uuid
  parentId        String?    @db.Uuid
  name            String
  slug            String     @unique
  attributeSchema Json?
  parent          Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children        Category[] @relation("CategoryTree")
  products        Product[]

  @@map("categories")
  @@schema("catalogue")
}

model Brand {
  id       String    @id @default(uuid()) @db.Uuid
  name     String    @unique
  slug     String    @unique
  products Product[]

  @@map("brands")
  @@schema("catalogue")
}

model Product {
  id           String                   @id @default(uuid()) @db.Uuid
  categoryId   String                   @db.Uuid
  brandId      String?                  @db.Uuid
  name         String
  slug         String                   @unique
  description  String
  attributes   Json                     @default("{}")
  images       Json                     @default("[]")
  status       String                   @default("draft")
  version      Int                      @default(0)
  /// Generated by PostgreSQL from name and description (migration 0005). Never written by the app.
  searchVector Unsupported("tsvector")? @default(dbgenerated())
  createdAt    DateTime                 @default(now()) @db.Timestamptz
  updatedAt    DateTime                 @updatedAt @db.Timestamptz
  category     Category                 @relation(fields: [categoryId], references: [id])
  brand        Brand?                   @relation(fields: [brandId], references: [id])
  variants     ProductVariant[]

  @@index([categoryId, status])
  @@index([searchVector], type: Gin)
  @@map("products")
  @@schema("catalogue")
}

model ProductVariant {
  id          String    @id @default(uuid()) @db.Uuid
  productId   String    @db.Uuid
  sku         String    @unique
  options     Json      @default("{}")
  weightGrams Int
  /// Display order within the product, in the order variants were added.
  position    Int       @default(0)
  product     Product   @relation(fields: [productId], references: [id])
  listings    Listing[]

  @@index([productId, position])
  @@map("product_variants")
  @@schema("catalogue")
}

model Listing {
  id             String         @id @default(uuid()) @db.Uuid
  variantId      String         @db.Uuid
  sellerId       String         @db.Uuid
  priceMinor     BigInt
  /// The usual price, shown struck through when it is higher than priceMinor. Null means no discount.
  compareAtMinor BigInt?
  currency       String         @db.Char(3)
  status         String         @default("draft")
  version        Int            @default(0)
  variant        ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([variantId, sellerId])
  @@index([sellerId, status])
  @@map("listings")
  @@schema("catalogue")
}

/// Product photos, stored once per distinct file (sha256). Behind the catalogue's media port,
/// so object storage can replace the table without touching callers.
model ProductMedia {
  id              String   @id @db.Uuid
  sha256          String   @unique
  contentType     String
  sizeBytes       Int
  /// The file itself while files are kept in the database; null when it is in a storage location.
  content         Bytes?
  /// storage.objects.id when the file is kept in a storage location. Not a foreign key: another schema.
  storageObjectId String?  @db.Uuid
  /// Where the file was downloaded from, when it came from an import.
  sourceUrl       String?
  createdAt       DateTime @default(now()) @db.Timestamptz

  @@index([sourceUrl])
  @@map("product_media")
  @@schema("catalogue")
}

/// One uploaded product file (CSV now; JSON and XML later), checked before anything is created.
model ImportJob {
  id         String       @id @db.Uuid
  format     String
  fileName   String
  sha256     String
  sizeBytes  Int
  mode       String
  status     String
  /// File-level problems, such as a missing column. A job with any cannot be started.
  issues     Json         @default("[]")
  summary    Json         @default("{}")
  createdBy  String       @db.Uuid
  createdAt  DateTime     @default(now()) @db.Timestamptz
  startedAt  DateTime?    @db.Timestamptz
  finishedAt DateTime?    @db.Timestamptz
  /// A worker holds the job until this time; a crashed worker's job is picked up after it.
  leaseUntil DateTime?    @db.Timestamptz
  version    Int          @default(0)
  items      ImportItem[]

  @@index([status, leaseUntil])
  @@index([createdAt])
  @@map("import_jobs")
  @@schema("catalogue")
}

/// One product in an import (one or more rows sharing a handle) and what happened to it.
model ImportItem {
  id          String    @id @db.Uuid
  jobId       String    @db.Uuid
  position    Int
  handle      String
  name        String
  rowNumbers  Json
  payload     Json
  action      String
  status      String
  errors      Json      @default("[]")
  warnings    Json      @default("[]")
  productId   String?   @db.Uuid
  processedAt DateTime? @db.Timestamptz
  job         ImportJob @relation(fields: [jobId], references: [id])

  @@unique([jobId, position])
  @@index([jobId, status, position])
  @@map("import_items")
  @@schema("catalogue")
}

// ---------- inventory (including warehousing) ----------

model Warehouse {
  id       String      @id @default(uuid()) @db.Uuid
  sellerId String      @db.Uuid
  name     String
  address  Json
  stock    StockItem[]

  @@map("warehouses")
  @@schema("inventory")
}

model StockItem {
  id           String             @id @default(uuid()) @db.Uuid
  listingId    String             @db.Uuid
  warehouseId  String             @db.Uuid
  onHand       Int                @default(0)
  reserved     Int                @default(0)
  version      Int                @default(0)
  warehouse    Warehouse          @relation(fields: [warehouseId], references: [id])
  reservations StockReservation[]
  movements    StockMovement[]

  @@unique([listingId, warehouseId])
  @@map("stock_items")
  @@schema("inventory")
}

model StockReservation {
  id          String    @id @default(uuid()) @db.Uuid
  stockItemId String    @db.Uuid
  checkoutId  String    @db.Uuid
  quantity    Int
  status      String    @default("held")
  expiresAt   DateTime  @db.Timestamptz
  createdAt   DateTime  @default(now()) @db.Timestamptz
  stockItem   StockItem @relation(fields: [stockItemId], references: [id])

  @@unique([checkoutId, stockItemId])
  @@index([status, expiresAt])
  @@index([checkoutId])
  @@map("stock_reservations")
  @@schema("inventory")
}

model StockMovement {
  id          String    @id @default(uuid()) @db.Uuid
  stockItemId String    @db.Uuid
  delta       Int
  reason      String
  sourceType  String
  sourceId    String
  createdAt   DateTime  @default(now()) @db.Timestamptz
  stockItem   StockItem @relation(fields: [stockItemId], references: [id])

  @@unique([stockItemId, sourceType, sourceId])
  @@index([sourceType, sourceId])
  @@index([stockItemId, createdAt])
  @@map("stock_movements")
  @@schema("inventory")
}

// ---------- cart ----------

model Cart {
  id         String     @id @default(uuid()) @db.Uuid
  /// Exactly one of customerId and guestToken is set (migration 0007). guestToken holds a SHA-256 hash.
  customerId String?    @db.Uuid
  guestToken String?    @unique
  version    Int        @default(0)
  updatedAt  DateTime   @updatedAt @db.Timestamptz
  items      CartItem[]

  @@index([customerId])
  @@map("carts")
  @@schema("cart")
}

model CheckoutSession {
  id             String   @id @db.Uuid
  customerId     String   @db.Uuid
  idempotencyKey String
  status         String   @default("awaiting_payment")
  currency       String   @db.Char(3)
  lines          Json
  address        Json
  subtotalMinor  BigInt
  deliveryMinor  BigInt
  totalMinor     BigInt
  weightGrams    Int
  expiresAt      DateTime @db.Timestamptz
  paymentId      String?  @db.Uuid
  stockIssue     Boolean  @default(false)
  version        Int      @default(0)
  createdAt      DateTime @default(now()) @db.Timestamptz
  updatedAt      DateTime @updatedAt @db.Timestamptz

  @@unique([customerId, idempotencyKey])
  @@index([customerId, status])
  @@map("checkout_sessions")
  @@schema("cart")
}

model CartItem {
  id        String @id @default(uuid()) @db.Uuid
  cartId    String @db.Uuid
  listingId String @db.Uuid
  quantity  Int
  /// Display order, in the order lines were added.
  position  Int    @default(0)
  cart      Cart   @relation(fields: [cartId], references: [id])

  @@unique([cartId, listingId])
  @@map("cart_items")
  @@schema("cart")
}

// ---------- orders ----------

model Order {
  id                 String        @id @default(uuid()) @db.Uuid
  number             String        @unique
  /// The paid checkout this order came from. One order per checkout.
  checkoutId         String        @unique @db.Uuid
  paymentId          String        @db.Uuid
  customerId         String        @db.Uuid
  status             String        @default("placed")
  currency           String        @db.Char(3)
  subtotalMinor      BigInt
  deliveryMinor      BigInt
  discountMinor      BigInt        @default(0)
  totalMinor         BigInt
  shippingAddress    Json
  version            Int           @default(0)
  placedAt           DateTime      @default(now()) @db.Timestamptz
  /// Set together when staff cancel the order.
  cancelledAt        DateTime?     @db.Timestamptz
  cancelledBy        String?       @db.Uuid
  cancellationReason String?
  createdAt          DateTime      @default(now()) @db.Timestamptz
  updatedAt          DateTime      @updatedAt @db.Timestamptz
  sellerOrders       SellerOrder[]
  refunds            OrderRefund[]

  @@index([customerId, createdAt])
  @@index([status, placedAt])
  @@index([paymentId])
  @@map("orders")
  @@schema("orders")
}

/// A completed refund of the order's payment, recorded from PaymentRefunded.
model OrderRefund {
  refundId    String   @id @db.Uuid
  orderId     String   @db.Uuid
  amountMinor BigInt
  refundedAt  DateTime @db.Timestamptz
  order       Order    @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@map("order_refunds")
  @@schema("orders")
}

model SellerOrder {
  id       String      @id @default(uuid()) @db.Uuid
  orderId  String      @db.Uuid
  sellerId String      @db.Uuid
  status   String      @default("pending")
  position Int         @default(0)
  version  Int         @default(0)
  order    Order       @relation(fields: [orderId], references: [id])
  lines    OrderLine[]

  @@index([orderId])
  @@index([sellerId, status])
  @@map("seller_orders")
  @@schema("orders")
}

model OrderLine {
  id             String      @id @default(uuid()) @db.Uuid
  sellerOrderId  String      @db.Uuid
  listingId      String      @db.Uuid
  variantId      String      @db.Uuid
  productName    String
  sku            String
  options        Json        @default("{}")
  quantity       Int
  unitPriceMinor BigInt
  lineTotalMinor BigInt
  position       Int         @default(0)
  sellerOrder    SellerOrder @relation(fields: [sellerOrderId], references: [id])

  @@index([sellerOrderId])
  @@map("order_lines")
  @@schema("orders")
}

// ---------- payments ----------

enum PaymentStatus {
  initiated
  succeeded
  failed
  requires_review
  partially_refunded
  refunded

  @@schema("payments")
}

model Payment {
  id                    String           @id @default(uuid()) @db.Uuid
  /// The checkout session this pays for. The order is created after verification.
  checkoutId            String           @db.Uuid
  gatewayId             String?          @db.Uuid
  redirectUrl           String?
  reference             String           @unique
  provider              String
  amountMinor           BigInt
  currency              String           @db.Char(3)
  status                PaymentStatus    @default(initiated)
  providerTransactionId String?
  refundedMinor         BigInt           @default(0)
  refundPendingMinor    BigInt           @default(0)
  version               Int              @default(0)
  createdAt             DateTime         @default(now()) @db.Timestamptz
  updatedAt             DateTime         @updatedAt @db.Timestamptz
  attempts              PaymentAttempt[]
  refunds               Refund[]

  @@unique([provider, providerTransactionId])
  @@index([checkoutId])
  @@index([gatewayId])
  @@map("payments")
  @@schema("payments")
}

model PaymentGateway {
  id          String   @id @db.Uuid
  type        String
  name        String
  enabled     Boolean  @default(false)
  mode        String   @default("test")
  position    Int      @default(0)
  config      Json     @default("{}")
  /// AES-256-GCM ciphertext of the credentials. Never plain text.
  secrets     String?
  secretHints Json     @default("{}")
  version     Int      @default(0)
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @updatedAt @db.Timestamptz

  @@map("gateways")
  @@schema("payments")
}

model PaymentAttempt {
  id        String   @id @default(uuid()) @db.Uuid
  paymentId String   @db.Uuid
  outcome   String
  response  Json
  createdAt DateTime @default(now()) @db.Timestamptz
  payment   Payment  @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
  @@map("payment_attempts")
  @@schema("payments")
}

model WebhookEvent {
  id              String    @id @default(uuid()) @db.Uuid
  provider        String
  providerEventId String
  receivedAt      DateTime  @default(now()) @db.Timestamptz
  processedAt     DateTime? @db.Timestamptz

  @@unique([provider, providerEventId])
  @@map("webhook_events")
  @@schema("payments")
}

model Refund {
  id               String   @id @default(uuid()) @db.Uuid
  paymentId        String   @db.Uuid
  amountMinor      BigInt
  currency         String   @db.Char(3)
  status           String   @default("pending")
  providerRefundId String?
  reason           String
  requestedBy      String   @db.Uuid
  gatewayStatus    String?
  failureReason    String?
  resolvedBy       String?  @db.Uuid
  version          Int      @default(0)
  createdAt        DateTime @default(now()) @db.Timestamptz
  updatedAt        DateTime @default(now()) @updatedAt @db.Timestamptz
  payment          Payment  @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
  @@map("refunds")
  @@schema("payments")
}

// ---------- ledger (append-only, enforced by database triggers) ----------

enum LedgerSide {
  debit
  credit

  @@schema("ledger")
}

model LedgerAccount {
  code  String        @id
  name  String
  type  String
  lines JournalLine[]

  @@map("accounts")
  @@schema("ledger")
}

model JournalEntry {
  id         String        @id @default(uuid()) @db.Uuid
  sourceType String
  sourceId   String
  /// The customer payment this entry concerns, when there is one.
  paymentId  String?       @db.Uuid
  postedAt   DateTime      @db.Timestamptz
  lines      JournalLine[]

  @@unique([sourceType, sourceId])
  @@index([paymentId])
  @@map("journal_entries")
  @@schema("ledger")
}

model JournalLine {
  id          String        @id @default(uuid()) @db.Uuid
  entryId     String        @db.Uuid
  accountCode String
  side        LedgerSide
  amountMinor BigInt
  currency    String        @db.Char(3)
  entry       JournalEntry  @relation(fields: [entryId], references: [id])
  account     LedgerAccount @relation(fields: [accountCode], references: [code])

  @@index([entryId])
  @@index([accountCode])
  @@map("journal_lines")
  @@schema("ledger")
}

// ---------- shipping (including logistics) ----------

enum FulfilmentMode {
  vendra_dispatch
  carrier
  vendor_managed
  supplier_managed

  @@schema("shipping")
}

enum ShipmentStatus {
  created
  allocated
  picked_up
  in_transit
  out_for_delivery
  delivered
  delivery_failed
  returning
  returned
  cancelled

  @@schema("shipping")
}

model DeliveryZone {
  id     String         @id @default(uuid()) @db.Uuid
  code   String         @unique
  name   String
  states String[]
  rates  DeliveryRate[]

  @@map("delivery_zones")
  @@schema("shipping")
}

model DeliveryRate {
  id             String       @id @default(uuid()) @db.Uuid
  zoneId         String       @db.Uuid
  maxWeightGrams Int
  priceMinor     BigInt
  currency       String       @db.Char(3)
  zone           DeliveryZone @relation(fields: [zoneId], references: [id])

  @@unique([zoneId, maxWeightGrams])
  @@map("delivery_rates")
  @@schema("shipping")
}

model Shipment {
  id                String                @id @default(uuid()) @db.Uuid
  sellerOrderId     String                @db.Uuid
  mode              FulfilmentMode
  status            ShipmentStatus        @default(created)
  provider          String
  courier           String?
  trackingReference String?
  version           Int                   @default(0)
  createdAt         DateTime              @default(now()) @db.Timestamptz
  updatedAt         DateTime              @default(now()) @updatedAt @db.Timestamptz
  items             ShipmentItem[]
  history           ShipmentStatusEvent[]
  attempts          DeliveryAttempt[]

  @@unique([courier, trackingReference])
  @@index([sellerOrderId])
  @@index([status])
  @@map("shipments")
  @@schema("shipping")
}

model ShipmentItem {
  id          String   @id @default(uuid()) @db.Uuid
  shipmentId  String   @db.Uuid
  orderLineId String   @db.Uuid
  quantity    Int
  shipment    Shipment @relation(fields: [shipmentId], references: [id])

  @@unique([shipmentId, orderLineId])
  @@map("shipment_items")
  @@schema("shipping")
}

model ShipmentStatusEvent {
  id         String         @id @default(uuid()) @db.Uuid
  shipmentId String         @db.Uuid
  sequence   Int
  status     ShipmentStatus
  note       String?
  at         DateTime       @db.Timestamptz
  shipment   Shipment       @relation(fields: [shipmentId], references: [id])

  @@unique([shipmentId, sequence])
  @@index([shipmentId, at])
  @@map("shipment_status_events")
  @@schema("shipping")
}

model DeliveryAttempt {
  id            String   @id @default(uuid()) @db.Uuid
  shipmentId    String   @db.Uuid
  attemptNumber Int
  successful    Boolean
  reason        String?
  at            DateTime @db.Timestamptz
  shipment      Shipment @relation(fields: [shipmentId], references: [id])

  @@unique([shipmentId, attemptNumber])
  @@map("delivery_attempts")
  @@schema("shipping")
}

// ---------- storage (where uploaded files are kept) ----------

/// A storage service staff configured in Admin. At most one is active (a partial unique index);
/// with none active, files are kept in the database.
model StorageLocation {
  id             String          @id @db.Uuid
  type           String
  name           String
  config         Json            @default("{}")
  /// AES-256-GCM ciphertext of the credentials. Never plain text.
  secrets        String?
  secretHints    Json            @default("{}")
  active         Boolean         @default(false)
  lastCheckedAt  DateTime?       @db.Timestamptz
  lastCheckOk    Boolean?
  lastCheckError String?
  version        Int             @default(0)
  createdAt      DateTime        @default(now()) @db.Timestamptz
  updatedAt      DateTime        @updatedAt @db.Timestamptz
  objects        StorageObject[]

  @@map("locations")
  @@schema("storage")
}

/// One file written to a storage location. Rows are never moved: a file is read from where it was written.
model StorageObject {
  id          String          @id @db.Uuid
  locationId  String          @db.Uuid
  key         String
  contentType String
  sizeBytes   Int
  sha256      String
  purpose     String
  createdAt   DateTime        @default(now()) @db.Timestamptz
  /// Set when a move gave the file a new copy elsewhere and this one was kept. No record points here any more.
  supersededAt DateTime?      @db.Timestamptz
  location    StorageLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@unique([locationId, key])
  @@index([locationId])
  @@map("objects")
  @@schema("storage")
}

/// Moves files that are not in a location yet (in the database, or in another location) into it.
/// One job at a time (a partial unique index on queued and running jobs).
model StorageMoveJob {
  id               String    @id @db.Uuid
  targetLocationId String    @db.Uuid
  /// queued | running | completed | cancelled | failed
  status           String
  /// Delete the copy in the old storage location once a file is moved. Bytes in the database are always cleared.
  deleteOld        Boolean
  total            Int
  moved            Int       @default(0)
  skipped          Int       @default(0)
  failed           Int       @default(0)
  movedBytes       BigInt    @default(0)
  /// Where to resume: which kind of file, and the last row done.
  cursor           Json      @default("{}")
  /// The latest problems, newest first, at most 20.
  problems         Json      @default("[]")
  message          String?
  createdBy        String    @db.Uuid
  createdAt        DateTime  @default(now()) @db.Timestamptz
  startedAt        DateTime? @db.Timestamptz
  finishedAt       DateTime? @db.Timestamptz
  leaseUntil       DateTime? @db.Timestamptz
  version          Int       @default(0)

  @@index([createdAt])
  @@map("move_jobs")
  @@schema("storage")
}
