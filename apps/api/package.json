{
  "name": "@vendra/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "tsc -p tsconfig.build.json --watch",
    "start": "node dist/main.js",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "test": "prisma generate && jest",
    "test:integration": "prisma generate && node --env-file-if-exists=.env node_modules/jest/bin/jest.js --config jest.integration.json --runInBand",
    "openapi:export": "prisma generate && tsc -p tsconfig.build.json && node dist/openapi-export.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.9",
    "@nestjs/core": "^11.2.9",
    "@nestjs/platform-express": "^11.2.9",
    "@nestjs/swagger": "^11.4.8",
    "@prisma/client": "~6.19.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "@vendra/config": "workspace:*",
    "jest": "^30.5.2",
    "prisma": "~6.19.3",
    "ts-jest": "^29.4.15",
    "typescript": "~5.9.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": ["<rootDir>/src", "<rootDir>/test"],
    "testRegex": ".*\\.spec\\.ts$"
  }
}
