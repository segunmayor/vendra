# Copy to apps/api/.env for local development. Never commit real values.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://vendra:vendra_local@localhost:55432/vendra_dev
DIRECT_DATABASE_URL=postgresql://vendra:vendra_local@localhost:55432/vendra_dev
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-at-least-32-random-characters
TRUST_PROXY_HOPS=0
# Seconds between sweeps that release lapsed stock holds. 0 turns the sweep off.
RESERVATION_SWEEP_SECONDS=60
# Milliseconds between deliveries of events between modules. 0 turns polling off.
OUTBOX_POLL_MS=2000
# Encrypts secrets kept in the database: payment gateway keys and staff two-step sign-in. Generate with:
# openssl rand -base64 32   (changing it later means re-entering gateway keys and resetting staff two-step sign-in)
SETTINGS_ENCRYPTION_KEY=
# Same value in the API and all three portals. Generate with: openssl rand -hex 32
PORTAL_SHARED_SECRET=
# Portals only (apps/<portal>/.env.local): where the API is, and how many reverse proxies
# in front of the portal append X-Forwarded-For. Use 1 behind one load balancer. With 0
# the header is ignored, because a visitor could forge it.
API_BASE_URL=http://localhost:4000
PORTAL_TRUST_PROXY_HOPS=0
REDIS_URL=redis://localhost:56379
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
