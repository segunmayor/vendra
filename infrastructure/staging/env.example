# Copy to .env next to compose.yml and fill in. Never commit the filled-in file.

# Domains (DNS A/AAAA records must point at this host before starting Caddy).
STORE_DOMAIN=staging.example.ng
ADMIN_DOMAIN=admin.staging.example.ng
SELLERS_DOMAIN=sellers.staging.example.ng
API_DOMAIN=api.staging.example.ng
# Let's Encrypt contact for certificate expiry notices.
ACME_EMAIL=ops@example.ng
# Optional: space-separated CIDRs allowed to open Admin, e.g. "102.89.0.0/16 41.58.1.2/32".
ADMIN_ALLOWED_IPS=

# Secrets. Generate each one fresh for every environment:
#   POSTGRES_PASSWORD:        openssl rand -hex 24
#   JWT_SECRET:               openssl rand -base64 48
#   SETTINGS_ENCRYPTION_KEY:  openssl rand -base64 32   (losing it means re-entering gateway keys
#                             and resetting staff two-step sign-in: keep a copy in the password manager)
#   PORTAL_SHARED_SECRET:     openssl rand -hex 32
POSTGRES_PASSWORD=
JWT_SECRET=
SETTINGS_ENCRYPTION_KEY=
PORTAL_SHARED_SECRET=

# Image tag, for example the git commit being deployed.
VENDRA_VERSION=latest
